# Copy this file to ".env" and fill in your real values.
# ".env" itself is in .gitignore, so it will NOT be uploaded to GitHub.

SMMS_DB_HOST=localhost
SMMS_DB_PORT=5432
SMMS_DB_NAME=final_db
SMMS_DB_USER=postgres
SMMS_DB_PASSWORD=your_real_password_here

# A random secret string used to salt password hashes.
SMMS_AUTH_SALT=change_this_to_a_random_string
